<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- usesCleartextTraffic is needed for the http:// dev-server flow; to be scoped to
       Debug builds. enableOnBackInvokedCallback=false keeps the classic OnBackPressed
       dispatch that GaldrActivity's back handling uses. Classic (non-adaptive)
       launcher icon, packed straight from the shared icon\ dir by the csproj;
       adaptive icon art is a possible follow-up. -->
  <application android:allowBackup="true" android:icon="@mipmap/appicon" android:label="@string/app_name" android:supportsRtl="true" android:usesCleartextTraffic="true" android:enableOnBackInvokedCallback="false">
  </application>
  <uses-permission android:name="android.permission.INTERNET" />
</manifest>
