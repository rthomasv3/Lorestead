<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lorestead.Client</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>obj/Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Devlooped.CredentialManager" />
    <PackageReference Include="Galdr.Native" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lorestead.Core\Lorestead.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <FrontEndDir>$(MSBuildProjectDirectory)/FrontEnd</FrontEndDir>
    <FrontEndDist>$(FrontEndDir)/dist</FrontEndDist>
    <ApplicationIcon>..\..\icon\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrontEndSource Include="$(FrontEndDir)/src/**/*" />
    <FrontEndSource Include="$(FrontEndDir)/index.html" />
    <FrontEndSource Include="$(FrontEndDir)/package.json" />
    <FrontEndSource Include="$(FrontEndDir)/vite.config.*" />
    <!-- The in-app logo is aliased out of the shared icon dir, so it is a front-end input too. -->
    <FrontEndSource Include="$(MSBuildProjectDirectory)/../../icon/icon.svg" />
  </ItemGroup>

  <Target Name="EnsureFrontEndBuilt" Condition="'$(Configuration)' == 'Release'" Inputs="@(FrontEndSource)" Outputs="$(FrontEndDist)/index.html">
    <Message Importance="high" Text="Galdr: building front end in $(FrontEndDir)" />
    <Exec Command="npm install" WorkingDirectory="$(FrontEndDir)" Condition="!Exists('$(FrontEndDir)/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontEndDir)" />
  </Target>

  <Target Name="StageFrontEnd" BeforeTargets="AssignTargetPaths" DependsOnTargets="EnsureFrontEndBuilt" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_GaldrDist Include="$(FrontEndDist)/**/*.*" />
      <Content Include="@(_GaldrDist)" CopyToOutputDirectory="PreserveNewest" TargetPath="wwwroot/%(_GaldrDist.RecursiveDir)%(_GaldrDist.Filename)%(_GaldrDist.Extension)" />
    </ItemGroup>
  </Target>

</Project>
