<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>SylvaNote.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- First-run content ships inside the assembly rather than as files beside it:
         it has to survive packaging on every platform and be readable by whichever
         host created the database (decisions.md). -->
    <EmbeddedResource Include="FirstRun\Content\*.md" />
    <EmbeddedResource Include="..\..\icon\icon-256.png"
                      LogicalName="SylvaNote.Core.FirstRun.Content.icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GaldrJson" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="ModelContextProtocol.Core" />
  </ItemGroup>

</Project>
