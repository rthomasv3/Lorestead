<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Devlooped.CredentialManager" Version="2.7.0" />
    <PackageVersion Include="Galdr.Native" Version="3.0.0-dev6" />
    <PackageVersion Include="GaldrJson" Version="1.2.2" />
    <PackageVersion Include="GaldrJson.AspNetCore" Version="1.2.1" />
    <!-- Provider-less core: each host picks its own SQLitePCLRaw bundle so the client
         (plain SQLite) and the server (SQLCipher) don't fight over batteries_v2. -->
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <!-- Client bundle; 2.1.12 lifts past GHSA-2m69-gcr7-jv3q (SQLite < 3.50.2). -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- Server bundle (SQLCipher at rest). Latest available; its SQLite core predates
         3.50.2 (CVE-2025-6965 needs attacker-run SQL, which the server never executes) -
         bump when a 2.1.12+ sqlcipher bundle ships. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
    <!-- Official MCP SDK; Core carries the tool/registration types (manual registration
         for AOT), AspNetCore adds MapMcp for the server's streamable HTTP transport. -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.4.1" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <!-- Mobile-only secure storage (Keychain / Keystore) behind SyncCredentialStore's
         mobile branch; a class library over the platform bindings, no MAUI app model. -->
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="10.0.90" />
    <!-- Transitive pin: Essentials asks for core-ktx 1.16 while another chain lifts
         AndroidX Core to 1.19; AndroidX merged the ktx classes into core, so the
         mismatched pair defines the same Kotlin classes twice and D8 fails
         ("Type androidx.core.* is defined multiple times"). Keep in lockstep with
         whatever Xamarin.AndroidX.Core resolves to. -->
    <PackageVersion Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.19.0.1" />
    <!-- Version stamping from git tags at build time; the repo carries no version of its own. -->
    <PackageVersion Include="MinVer" Version="7.0.0" />
    <!-- Installer + updates against GitHub Releases (distribution.md). Keep the vpk CLI
         used by the packaging scripts on the same version as this library. -->
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>